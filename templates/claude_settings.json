{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 -m patchgate.hooks.ide_guard" }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Edit", "Write", "NotebookEdit"]
  }
}
